# Application
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeflow_oms?schema=public"

# Redis / Queues / Cache
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider
# Supported values: fake, openai
AI_PROVIDER="fake"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENAI_TIMEOUT_MS=15000

# Email Provider
# Supported values: fake, resend
EMAIL_PROVIDER="fake"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ForgeFlow <onboarding@resend.dev>"
OPS_REVIEW_EMAIL="ops@example.com"